# Demo provider configuration. Copy to .env for local demo runs.

# Default with no env vars is fixture mode (offline committed fixtures/vectors).
# To run live, configure extraction and embedding independently.

# Extraction: fixture | anthropic | openai-compatible
DEMO_EXTRACT_PROVIDER=
DEMO_EXTRACT_BASE_URL=
DEMO_EXTRACT_API_KEY=
DEMO_EXTRACT_MODEL=

# Embedding: fixture | openai-compatible | ollama-native
DEMO_EMBED_PROVIDER=
DEMO_EMBED_BASE_URL=
DEMO_EMBED_API_KEY=
DEMO_EMBED_MODEL=
DEMO_EMBED_DIMENSION=768

# Optional demo observability:
# summary = show model-call boundaries and timing
# full = also print prompts, responses, embedding inputs, and vectors
DEMO_LLM_TRACE=

# Convenience presets supported by the demo resolver:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=http://localhost:11434
