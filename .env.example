# Demo provider configuration. Copy to .env for local demo runs.

# Default with no env vars is fixture mode (offline deterministic fixtures/vectors).
# To run live, configure extraction and embedding independently.

# Extraction: fixture | anthropic | openai-compatible
DEMO_EXTRACT_PROVIDER="openai-compatible"
DEMO_EXTRACT_BASE_URL="https://openrouter.ai/api/v1"
DEMO_EXTRACT_API_KEY=
DEMO_EXTRACT_MODEL="gpt-4o-mini"
DEMO_EXTRACT_RESPONSE_FORMAT="json_schema"
DEMO_EXTRACT_EXTRA_BODY_JSON={"reasoning":{"effort":"none","exclude":true}}
# Caps extraction output for live providers; defaults to 1200.
DEMO_EXTRACT_MAX_TOKENS=1200

# Embedding: fixture | openai-compatible | ollama-native
DEMO_VISION_PROVIDER="openai-compatible"
DEMO_VISION_BASE_URL="https://openrouter.ai/api/v1"
DEMO_EMBED_API_KEY=
DEMO_EMBED_MODEL="text-embedding-3-small"
DEMO_EMBED_EXTRA_BODY_JSON={"response_format":{"type":"float"}}
DEMO_EMBED_DIMENSION=768

# Vision description: fixture | anthropic | openai-compatible
# Used by the Big Brother demo during prepare unless --multimodal is supplied.
DEMO_VISION_PROVIDER="openai-compatible"
DEMO_VISION_BASE_URL="https://openrouter.ai/api/v1"
DEMO_VISION_API_KEY=
DEMO_VISION_MODEL="gpt-4o-mini"
DEMO_VISION_MAX_TOKENS=8192
DEMO_VISION_EXTRA_BODY_JSON={"reasoning":{"effort":"none","exclude":true}}

# Optional demo observability:
# summary = show model-call boundaries and timing
# full = also print prompts, responses, embedding inputs, and vector summaries
# DEMO_LLM_TRACE_RAW_VECTORS=1 prints complete vectors for low-level debugging
DEMO_LLM_TRACE=

# Optional live-provider pacing/retry:
# DEMO_RATE_LIMIT defaults to 5 seconds; override here or with --limit.
DEMO_RATE_LIMIT=
# DEMO_PROVIDER_MAX_ATTEMPTS=6
# DEMO_PROVIDER_BASE_DELAY_MS=1000
# DEMO_PROVIDER_MAX_DELAY_MS=30000

# Local provider preset supported by the demo resolver:
# OLLAMA_HOST=http://localhost:11434
