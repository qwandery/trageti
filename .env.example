# Demo provider secrets and legacy fallback variables. Copy to .env for local demo runs.

# Provider presets live in demos/providers.json. Put real secrets here and keep
# them out of JSON. Legacy DEMO_* variables below still override providers.json
# when present.

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Offline deterministic fixtures/vectors:
# npm run trageti-demo -- alex-place run --provider fixture

# Extraction: fixture | anthropic | openai-compatible
DEMO_EXTRACT_PROVIDER=
DEMO_EXTRACT_BASE_URL=
DEMO_EXTRACT_API_KEY=
DEMO_EXTRACT_MODEL=
DEMO_EXTRACT_RESPONSE_FORMAT=
DEMO_EXTRACT_EXTRA_BODY_JSON=
# Caps extraction output for live providers; defaults to 8192.
DEMO_EXTRACT_MAX_TOKENS=

# Embedding: fixture | openai-compatible | ollama-native
DEMO_EMBED_PROVIDER=
DEMO_EMBED_BASE_URL=
DEMO_EMBED_API_KEY=
DEMO_EMBED_MODEL=
DEMO_EMBED_EXTRA_BODY_JSON=
DEMO_EMBED_DIMENSION=

# Vision description: fixture | anthropic | openai-compatible
# Used by the Big Brother demo during prepare unless --multimodal is supplied.
DEMO_VISION_PROVIDER=
DEMO_VISION_BASE_URL=
DEMO_VISION_API_KEY=
DEMO_VISION_MODEL=
DEMO_VISION_MAX_TOKENS=
DEMO_VISION_EXTRA_BODY_JSON=

# Optional demo observability:
# summary = show model-call boundaries and timing
# full = also print prompts, responses, embedding inputs, and vector summaries
# DEMO_LLM_TRACE_RAW_VECTORS=1 prints complete vectors for low-level debugging
DEMO_LLM_TRACE=

# Optional live-provider pacing/retry:
# DEMO_RATE_LIMIT defaults to 5 seconds; override here or with --limit.
DEMO_RATE_LIMIT=
# DEMO_PROVIDER_MAX_ATTEMPTS=6
# DEMO_PROVIDER_BASE_DELAY_MS=1000
# DEMO_PROVIDER_MAX_DELAY_MS=30000
# DEMO_PROVIDER_TIMEOUT_MS=60000

# Local provider preset supported by the legacy env resolver:
# OLLAMA_HOST=http://localhost:11434
