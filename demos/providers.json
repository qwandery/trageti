{
  "version": 1,
  "runtimeDefaults": {
    "rateLimitSeconds": 5,
    "maxAttempts": 6,
    "contentlessMaxAttempts": 2,
    "baseDelayMs": 1000,
    "maxDelayMs": 30000,
    "timeoutMs": 60000
  },
  "providers": [
    {
      "id": "fixture",
      "label": "Fixture",
      "kind": "fixture",
      "supports": ["extract", "embed", "vision"],
      "extractModel": "committed-fixtures",
      "embedModel": "committed-vectors",
      "visionModel": "committed-fixtures"
    },
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "kind": "openai-compatible",
      "supports": ["extract", "vision"],
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "extractModel": "gpt-4o-mini",
      "extractMaxTokens": 8192,
      "extractResponseFormat": "json_schema",
      "extractExtraBody": {
        "reasoning": {
          "effort": "none",
          "exclude": true
        }
      },
      "visionModel": "gpt-4o-mini",
      "visionMaxTokens": 8192,
      "visionExtraBody": {
        "reasoning": {
          "effort": "none",
          "exclude": true
        }
      }
    },
    {
      "id": "openai",
      "label": "OpenAI",
      "kind": "openai-compatible",
      "supports": ["extract", "embed", "vision"],
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "extractModel": "gpt-4o-mini",
      "extractMaxTokens": 8192,
      "extractResponseFormat": "json_schema",
      "embedModel": "text-embedding-3-small",
      "embedDimension": 768,
      "embedExtraBody": {
        "response_format": {
          "type": "float"
        }
      },
      "visionModel": "gpt-4o-mini",
      "visionMaxTokens": 8192
    },
    {
      "id": "anthropic",
      "label": "Anthropic",
      "kind": "anthropic",
      "supports": ["extract", "vision"],
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "extractModel": "claude-sonnet-4-20250514",
      "extractMaxTokens": 8192,
      "visionModel": "claude-sonnet-4-20250514",
      "visionMaxTokens": 8192
    },
    {
      "id": "ollama",
      "label": "Ollama",
      "kind": "openai-compatible",
      "supports": ["extract", "embed"],
      "baseUrl": "http://127.0.0.1:11434/v1",
      "apiKey": "ollama",
      "extractModel": "llama3.1",
      "extractMaxTokens": 8192,
      "extractResponseFormat": "json_object",
      "embedKind": "ollama-native",
      "embedBaseUrl": "http://127.0.0.1:11434",
      "embedModel": "nomic-embed-text",
      "embedDimension": 768
    }
  ]
}
