{
  "version": 1,
  "runtimeDefaults": {
    "rateLimitSeconds": 5,
    "maxAttempts": 6,
    "contentlessMaxAttempts": 2,
    "baseDelayMs": 1000,
    "maxDelayMs": 30000,
    "timeoutMs": 60000
  },
  "default": {
    "provider": "openrouter-gpt-mini",
    "embed": {
      "provider": "ollama-embed"
    }
  },
  "providers": [
    {
      "id": "fixture",
      "label": "Fixture",
      "kind": "fixture",
      "supports": ["extract", "embed", "vision"],
      "model": "committed-fixtures",
      "embed": {
        "model": "committed-vectors"
      }
    },
    {
      "id": "openrouter-gpt-mini",
      "label": "OpenRouter (GPT-4o-Mini)",
      "kind": "openai-compatible",
      "supports": ["extract", "vision", "embed"],
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "model": "gpt-4o-mini",
      "maxTokens": 8192,
      "rateLimitSeconds": 30,
      "responseFormat": "json_schema",
      "extraBody": {
        "reasoning": {
          "effort": "none",
          "exclude": true
        }
      },
      "embed": {
        "model": "text-embedding-3-small",
        "dimensions": 768,
        "extraBody": {
          "extraBody": {
            "response_format": {
              "type": "float"
            }
          }
        }
      },
      "vision": {
        "extraBody": {
          "effort": "none",
          "exclude": true
        }
      }
    },
    {
      "id": "openai",
      "label": "OpenAI",
      "kind": "openai-compatible",
      "supports": ["extract", "embed", "vision"],
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "rateLimitSeconds": 30,
      "model": "gpt-4o-mini",
      "maxTokens": 8192,
      "responseFormat": "json_schema",
      "embed": {
        "model": "text-embedding-3-small",
        "dimensions": 768,
        "extraBody": {
          "response_format": {
            "type": "float"
          }
        }
      }
    },
    {
      "id": "anthropic",
      "label": "Anthropic",
      "kind": "anthropic",
      "supports": ["extract", "vision"],
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "model": "claude-sonnet-4.5",
      "maxTokens": 8192
    },
    {
      "id": "ollama",
      "label": "Ollama",
      "kind": "openai-compatible",
      "supports": ["extract", "vision"],
      "baseUrl": "http://127.0.0.1:11434/v1",
      "model": "gemma4:12b",
      "maxTokens": 8192
    },
    {
      "id": "ollama-embed",
      "label": "Ollama (Nomic Embedding)",
      "kind": "openai-compatible",
      "supports": ["embed"],
      "baseUrl": "http://127.0.0.1:11435/v1",
      "model": "qwen3-embedding:4b",
      "dimensions": 1024
    }
  ]
}
